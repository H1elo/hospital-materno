{% extends 'layouts/public.twig' %}
{% import 'partials/icon.twig' as ui %}

{% block title %}Inicio - {{ app_name }}{% endblock %}

{% set nav_links = [
    { label: 'Inicio', href: '#inicio' },
    { label: 'Servicios', href: '#servicios' },
    { label: 'Horarios', href: '#horarios' },
    { label: 'Nosotros', href: '#nosotros' },
    { label: 'Contacto', href: '#contacto' }
] %}

{% set servicios = [
    { icon: 'baby', title: 'Maternidad', color: 'pink', desc: 'Acompanamos cada etapa de tu embarazo con atencion personalizada y cuidado integral.' },
    { icon: 'stethoscope', title: 'Ginecologia', color: 'blue', desc: 'Especialistas dedicados a la salud femenina en cada etapa de la vida.' },
    { icon: 'heart', title: 'Neonatologia', color: 'mint', desc: 'Cuidado especializado para recien nacidos con tecnologia de vanguardia.' },
    { icon: 'shield', title: 'Pediatria', color: 'lavanda', desc: 'Seguimiento medico profesional para el crecimiento sano de tu bebe.' }
] %}

{% set color_map = {
    pink:    { bg: 'bg-primary-soft',    icon: 'text-primary',    border: 'border-primary-soft' },
    blue:    { bg: 'bg-secondary-soft',  icon: 'text-secondary',  border: 'border-secondary-soft' },
    mint:    { bg: 'bg-accent-soft',     icon: 'text-accent-dark', border: 'border-accent-soft' },
    lavanda: { bg: 'bg-lavanda-soft',    icon: 'text-lavanda',    border: 'border-lavanda-soft' }
} %}

{% block body %}
<div class="min-h-screen bg-background text-foreground">

    {# --------------------------------- NAV --------------------------------- #}
    <header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-header>
        <nav class="mx-auto flex h-18 max-w-6xl items-center justify-between px-6 py-4">
            <a href="#inicio" class="group flex items-center gap-2.5">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary-soft shadow-sm">
                    {{ ui.icon('heart', 'w-[18px] h-[18px] text-primary fill-primary') }}
                </span>
                <span class="font-serif text-xl font-bold tracking-tight">
                    Hospital Materno <span class="text-primary">Rosa</span>
                </span>
            </a>

            <ul class="hidden items-center gap-1 md:flex">
                {% for link in nav_links %}
                    <li>
                        <a href="{{ link.href }}" class="rounded-full px-4 py-2 text-sm font-semibold text-foreground/70 transition-all duration-200 hover:bg-primary-soft hover:text-primary">
                            {{ link.label }}
                        </a>
                    </li>
                {% endfor %}
                <li>
                    <a href="{{ url('/login') }}" class="ml-2 flex items-center gap-2 rounded-full border border-primary px-5 py-2.5 text-sm font-bold text-primary transition-all duration-200 hover:bg-primary-soft">
                        {{ ui.icon('log-in', 'w-[15px] h-[15px]') }}
                        Iniciar sesion
                    </a>
                </li>
                <li>
                    <a href="#contacto" class="ml-1 rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-all duration-200 hover:bg-primary-dark">
                        Pedir cita
                    </a>
                </li>
            </ul>

            <button type="button" class="rounded-full p-2 transition-colors hover:bg-primary-soft md:hidden" data-menu-toggle aria-label="Menu">
                {{ ui.icon('menu', 'w-[22px] h-[22px] text-foreground') }}
            </button>
        </nav>

        <div id="mobile-menu" class="hidden border-t border-border-soft/40 bg-white px-6 py-4 shadow-md md:hidden">
            <div class="flex flex-col gap-2">
                {% for link in nav_links %}
                    <a href="{{ link.href }}" class="rounded-xl px-3 py-3 text-left font-semibold text-foreground/80 transition-all hover:bg-primary-soft hover:text-primary">
                        {{ link.label }}
                    </a>
                {% endfor %}
                <a href="{{ url('/login') }}" class="flex items-center justify-center gap-2 rounded-full border border-primary py-3 font-bold text-primary transition-all hover:bg-primary-soft">
                    {{ ui.icon('log-in', 'w-[15px] h-[15px]') }}
                    Iniciar sesion
                </a>
                <a href="#contacto" class="rounded-full bg-primary py-3 text-center font-bold text-white transition-all hover:bg-primary-dark">
                    Pedir cita
                </a>
            </div>
        </div>
    </header>

    {# --------------------------------- HERO -------------------------------- #}
    <section id="inicio" class="relative flex min-h-screen items-center overflow-hidden pt-20"
             style="background: linear-gradient(135deg, #FFF0F5 0%, #FFF8FB 40%, #EBF5FC 100%);">
        <div class="pointer-events-none absolute right-0 top-20 h-96 w-96 rounded-full bg-[#FFD6E5] opacity-40 blur-3xl"></div>
        <div class="pointer-events-none absolute bottom-0 left-10 h-72 w-72 rounded-full bg-[#C5E8F8] opacity-35 blur-3xl"></div>
        <div class="pointer-events-none absolute right-1/4 top-1/2 h-48 w-48 rounded-full bg-[#D4F5E9] opacity-30 blur-2xl"></div>

        <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-6 py-16 lg:grid-cols-2">
            <div class="relative z-10">
                <span class="mb-6 inline-flex items-center gap-2 rounded-full bg-primary-soft px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary-deep">
                    {{ ui.icon('heart', 'w-3 h-3 fill-current') }}
                    Cuidando vidas desde 2009
                </span>

                <h1 class="mb-6 font-serif text-5xl leading-[1.1] text-foreground lg:text-6xl">
                    Donde cada <em class="not-italic text-primary">vida</em> comienza<br>con amor
                </h1>

                <p class="mb-8 max-w-md text-lg leading-relaxed text-foreground/60">
                    Brindamos atencion medica especializada con calidez humana para mama y bebe.
                    Tu familia en las mejores manos.
                </p>

                <div class="flex flex-wrap gap-4">
                    <a href="{{ url('/login') }}" class="flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 font-bold text-white shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-dark hover:shadow-lg">
                        Agendar cita
                        {{ ui.icon('chevron-right', 'w-4 h-4') }}
                    </a>
                    <a href="#horarios" class="flex items-center gap-2 rounded-full border border-border-soft bg-white px-7 py-3.5 font-semibold text-foreground shadow-sm transition-all duration-200 hover:border-primary hover:text-primary">
                        {{ ui.icon('clock', 'w-4 h-4') }}
                        Ver horarios
                    </a>
                </div>

                <div class="mt-12 flex flex-wrap gap-6">
                    {% for item in [
                        { icon: 'baby', label: '8,400+ bebes nacidos' },
                        { icon: 'star', label: '98% satisfaccion' },
                        { icon: 'shield', label: 'Emergencias 24/7' }
                    ] %}
                        <div class="flex items-center gap-2 text-sm font-semibold text-foreground/60">
                            {{ ui.icon(item.icon, 'w-[15px] h-[15px] text-primary') }}
                            {{ item.label }}
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="relative z-10 hidden lg:block">
                <div class="relative">
                    <div class="absolute -inset-4 rounded-[2.5rem] bg-gradient-to-br from-[#FFD6E5] to-[#C5E8F8] opacity-50"></div>
                    <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-primary-soft shadow-2xl">
                        <img src="https://images.unsplash.com/photo-1766299893052-107053bc92a1?w=720&h=900&fit=crop&auto=format"
                             alt="Madre sosteniendo a su recien nacido" class="h-full w-full object-cover">
                        <div class="absolute inset-x-6 bottom-6 rounded-2xl bg-white/90 p-4 shadow-lg backdrop-blur-sm">
                            <div class="flex items-center gap-3">
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-soft">
                                    {{ ui.icon('alert', 'w-[18px] h-[18px] text-primary') }}
                                </span>
                                <div>
                                    <p class="text-xs font-bold">Emergencias</p>
                                    <p class="font-serif text-lg font-bold text-primary">24 horas / 7 dias</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ------------------------------- SERVICIOS ----------------------------- #}
    <section id="servicios" class="bg-white py-24">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mb-16 text-center">
                <span class="section-eyebrow text-secondary">Especialidades</span>
                <h2 class="mb-4 mt-3 font-serif text-4xl text-foreground">Nuestros servicios</h2>
                <p class="mx-auto max-w-md leading-relaxed text-foreground/60">
                    Contamos con especialistas de alto nivel para cada etapa del cuidado materno-infantil.
                </p>
            </div>

            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                {% for servicio in servicios %}
                    {% set c = color_map[servicio.color] %}
                    <div class="group rounded-3xl border {{ c.bg }} {{ c.border }} p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                        <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-white shadow-sm transition-transform duration-300 group-hover:scale-110">
                            {{ ui.icon(servicio.icon, 'w-[22px] h-[22px] ' ~ c.icon) }}
                        </div>
                        <h3 class="mb-2 text-lg font-bold text-foreground">{{ servicio.title }}</h3>
                        <p class="text-sm leading-relaxed text-foreground/55">{{ servicio.desc }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# -------------------------------- HORARIOS ----------------------------- #}
    <section id="horarios" class="py-24" style="background: linear-gradient(160deg, #EBF5FC 0%, #FFF0F5 60%, #EAF7EF 100%);">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mb-16 text-center">
                <span class="section-eyebrow text-primary">Atencion</span>
                <h2 class="mb-4 mt-3 font-serif text-4xl text-foreground">Horarios de atencion</h2>
                <p class="mx-auto max-w-md text-foreground/60">Estamos disponibles cuando mas nos necesitas.</p>
            </div>

            <div class="mx-auto grid max-w-3xl gap-8 md:grid-cols-2">
                <div class="card-soft border-primary-soft/40">
                    <div class="mb-6 flex items-center gap-3">
                        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary-soft">
                            {{ ui.icon('clock', 'w-[22px] h-[22px] text-primary') }}
                        </span>
                        <div>
                            <p class="text-xs font-bold uppercase tracking-wider text-primary">Consultas</p>
                            <h3 class="text-xl font-bold text-foreground">Atencion General</h3>
                        </div>
                    </div>
                    <div class="space-y-3">
                        {% for dia in ['Lunes', 'Martes', 'Miercoles', 'Jueves', 'Viernes'] %}
                            <div class="flex items-center justify-between border-b border-[#FFF0F5] py-3 last:border-0">
                                <span class="text-sm font-semibold text-foreground/70">{{ dia }}</span>
                                <span class="rounded-full bg-[#FFF0F5] px-3 py-1 text-sm font-bold text-foreground">7:00 am - 12:00 pm</span>
                            </div>
                        {% endfor %}
                        <div class="flex items-center justify-between py-3">
                            <span class="text-sm font-semibold text-foreground/40">Sabado - Domingo</span>
                            <span class="rounded-full bg-muted px-3 py-1 text-sm font-semibold text-foreground/40">Cerrado</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col justify-between rounded-3xl border border-secondary-soft p-8 shadow-md"
                     style="background: linear-gradient(145deg, #EBF5FC 0%, #D6EDF8 100%);">
                    <div>
                        <div class="mb-6 flex items-center gap-3">
                            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-secondary">
                                {{ ui.icon('alert', 'w-[22px] h-[22px] text-white') }}
                            </span>
                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-secondary-deep">Urgencias</p>
                                <h3 class="text-xl font-bold text-foreground">Emergencias</h3>
                            </div>
                        </div>
                        <div class="mb-4 flex items-end gap-2">
                            <span class="font-serif text-6xl leading-none text-secondary-deep">24</span>
                            <span class="mb-2 text-2xl font-bold text-secondary-deep">/7</span>
                        </div>
                        <p class="mb-6 text-sm leading-relaxed text-foreground/65">
                            Nuestro equipo de emergencias esta disponible las 24 horas del dia, los 7 dias de la semana.
                        </p>
                        <div class="space-y-3">
                            {% for item in ['Parto de urgencia', 'Complicaciones obstetricas', 'Neonatologia critica', 'Ginecologia de urgencia'] %}
                                <div class="flex items-center gap-2.5">
                                    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-secondary-deep"></span>
                                    <span class="text-sm font-semibold text-foreground/70">{{ item }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <a href="tel:+18000000000" class="mt-8 flex items-center justify-center gap-2.5 rounded-full bg-secondary py-3.5 font-bold text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-secondary-dark hover:shadow-md">
                        {{ ui.icon('phone', 'w-[17px] h-[17px]') }}
                        Llamar ahora
                    </a>
                </div>
            </div>

            <p class="mt-8 text-center text-xs text-foreground/40">
                * Las citas de consulta general se atienden de lunes a viernes, de 7:00 am a 12:00 pm.
            </p>
        </div>
    </section>

    {# --------------------------------- STATS ------------------------------- #}
    <section class="border-y border-border-soft/40 bg-white py-16">
        <div class="mx-auto max-w-6xl px-6">
            <div class="grid grid-cols-2 gap-8 lg:grid-cols-4">
                {% for stat in [
                    { value: '15+', label: 'Anios de experiencia' },
                    { value: '8,400', label: 'Nacimientos atendidos' },
                    { value: '98%', label: 'Satisfaccion de pacientes' },
                    { value: '24/7', label: 'Emergencias disponibles' }
                ] %}
                    <div class="text-center">
                        <p class="mb-1 font-serif text-4xl text-primary">{{ stat.value }}</p>
                        <p class="text-sm font-semibold text-foreground/55">{{ stat.label }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# -------------------------------- NOSOTROS ----------------------------- #}
    <section id="nosotros" class="bg-white py-24">
        <div class="mx-auto grid max-w-6xl items-center gap-16 px-6 lg:grid-cols-2">
            <div class="relative hidden lg:block">
                <div class="grid grid-cols-2 gap-4">
                    <div class="aspect-square overflow-hidden rounded-3xl bg-primary-soft">
                        <img src="https://images.unsplash.com/photo-1766299893204-6b5892fa4ed2?w=400&h=400&fit=crop&auto=format"
                             alt="Paciente sonriendo" class="h-full w-full object-cover">
                    </div>
                    <div class="mt-8 aspect-square overflow-hidden rounded-3xl bg-secondary-soft">
                        <img src="https://images.unsplash.com/photo-1766299892744-a0b9d4e11707?w=400&h=400&fit=crop&auto=format"
                             alt="Madre amamantando" class="h-full w-full object-cover">
                    </div>
                </div>
                <div class="absolute -bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-3 rounded-2xl border border-border-soft/40 bg-white px-6 py-4 shadow-lg">
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-soft">
                        {{ ui.icon('users', 'w-[18px] h-[18px] text-accent-dark') }}
                    </span>
                    <div>
                        <p class="font-serif text-lg font-bold text-foreground">+30 especialistas</p>
                        <p class="text-xs font-semibold text-foreground/55">en nuestro equipo medico</p>
                    </div>
                </div>
            </div>

            <div>
                <span class="section-eyebrow text-accent-dark">Quienes somos?</span>
                <h2 class="mb-6 mt-3 font-serif text-4xl leading-tight text-foreground">
                    Un hospital que cuida con<em class="not-italic text-primary"> vocacion</em>
                </h2>
                <p class="mb-5 leading-relaxed text-foreground/60">
                    Desde 2009, el Hospital Materno Rosa ha acompanado a miles de familias en el momento mas
                    especial de sus vidas. Contamos con infraestructura moderna, tecnologia de punta y un
                    equipo medico comprometido con la excelencia.
                </p>
                <p class="mb-8 leading-relaxed text-foreground/60">
                    Nuestra mision es ofrecer atencion segura, calida y personalizada a cada mama y a cada
                    bebe que llega a nuestras instalaciones.
                </p>

                <div class="space-y-3">
                    {% for member in [
                        { name: 'Dra. Carmen Lopez', role: 'Ginecologa Obstetra', exp: '12 anios' },
                        { name: 'Dr. Andres Vargas', role: 'Neonatologo', exp: '9 anios' },
                        { name: 'Dra. Patricia Rojas', role: 'Pediatra', exp: '15 anios' }
                    ] %}
                        <div class="flex items-center gap-4 rounded-2xl border border-primary-soft bg-background p-4 transition-shadow hover:shadow-sm">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-soft">
                                {{ ui.icon('stethoscope', 'w-4 h-4 text-primary') }}
                            </span>
                            <div class="flex-1">
                                <p class="text-sm font-bold text-foreground">{{ member.name }}</p>
                                <p class="text-xs text-foreground/55">{{ member.role }}</p>
                            </div>
                            <span class="badge badge-pink">{{ member.exp }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    {# -------------------------------- CONTACTO ----------------------------- #}
    <section id="contacto" class="py-24" style="background: linear-gradient(160deg, #FFF0F5 0%, #EBF5FC 100%);">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mb-14 text-center">
                <span class="section-eyebrow text-lavanda">Contacto</span>
                <h2 class="mb-4 mt-3 font-serif text-4xl text-foreground">Estamos aqui para ti</h2>
                <p class="mx-auto max-w-md text-foreground/60">
                    Comunicate con nosotros o visitanos. Siempre habra alguien para atenderte.
                </p>
            </div>

            <div class="mb-12 grid gap-6 md:grid-cols-3">
                {% for item in [
                    { icon: 'phone', title: 'Telefono', detail: '+1 (800) 000-0000', sub: 'Lunes a Viernes', color: 'pink' },
                    { icon: 'alert', title: 'Emergencias', detail: '+1 (800) 911-0000', sub: '24 horas / 7 dias', color: 'blue' },
                    { icon: 'map-pin', title: 'Direccion', detail: 'Av. Salud 1240, Col. Centro', sub: 'Ciudad, Pais', color: 'mint' }
                ] %}
                    {% set c = color_map[item.color] %}
                    <div class="{{ c.bg }} {{ c.border }} rounded-3xl border p-7 text-center transition-all duration-200 hover:shadow-md">
                        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-white shadow-sm">
                            {{ ui.icon(item.icon, 'w-5 h-5 ' ~ c.icon) }}
                        </div>
                        <p class="mb-1 text-xs font-bold uppercase tracking-wider text-foreground/50">{{ item.title }}</p>
                        <p class="mb-1 text-base font-bold text-foreground">{{ item.detail }}</p>
                        <p class="text-xs font-semibold text-foreground/50">{{ item.sub }}</p>
                    </div>
                {% endfor %}
            </div>

            <div class="mx-auto max-w-xl rounded-3xl border border-primary-soft/40 bg-white p-10 text-center shadow-sm">
                <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-primary-soft">
                    {{ ui.icon('mail', 'w-6 h-6 text-primary') }}
                </div>
                <h3 class="mb-2 font-serif text-2xl text-foreground">Agenda tu cita hoy</h3>
                <p class="mb-7 text-sm leading-relaxed text-foreground/55">
                    Escribenos y nuestro equipo te confirmara la cita lo antes posible.
                </p>

                <form action="{{ url('/login') }}" method="get" class="flex flex-col gap-3 sm:flex-row">
                    <input type="text" name="nombre" placeholder="Tu nombre"
                           class="flex-1 rounded-full border border-primary-soft bg-background px-4 py-3 text-sm text-foreground placeholder:text-foreground/35 focus:outline-none focus:ring-2 focus:ring-primary/40">
                    <input type="tel" name="telefono" placeholder="Tu telefono"
                           class="flex-1 rounded-full border border-primary-soft bg-background px-4 py-3 text-sm text-foreground placeholder:text-foreground/35 focus:outline-none focus:ring-2 focus:ring-primary/40">
                </form>

                <a href="{{ url('/login') }}" class="mt-4 flex w-full items-center justify-center rounded-full bg-primary py-3.5 font-bold text-white shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-dark hover:shadow-lg">
                    Solicitar cita en el portal
                </a>
            </div>
        </div>
    </section>

    {# --------------------------------- FOOTER ------------------------------ #}
    <footer class="bg-foreground py-12 text-white">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mb-8 flex flex-col items-center justify-between gap-6 border-b border-white/10 pb-8 md:flex-row">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-soft">
                        {{ ui.icon('heart', 'w-[15px] h-[15px] text-primary fill-primary') }}
                    </span>
                    <span class="font-serif text-lg font-bold tracking-tight">
                        Hospital Materno <span class="text-primary">Rosa</span>
                    </span>
                </div>
                <div class="flex flex-wrap justify-center gap-6 text-sm text-white/50">
                    {% for link in nav_links %}
                        <a href="{{ link.href }}" class="transition-colors hover:text-white">{{ link.label }}</a>
                    {% endfor %}
                    <a href="{{ url('/login') }}" class="transition-colors hover:text-white">Iniciar sesion</a>
                </div>
            </div>
            <div class="flex flex-col items-center justify-between gap-4 text-xs text-white/35 md:flex-row">
                <p>&copy; {{ "now"|date("Y") }} Hospital Materno Rosa. Todos los derechos reservados.</p>
                <p class="flex items-center gap-1.5">
                    {{ ui.icon('heart', 'w-2.5 h-2.5 fill-primary text-primary') }}
                    Comprometidos con tu salud y la de tu familia
                </p>
            </div>
        </div>
    </footer>
</div>
{% endblock %}

{% block scripts %}
<script>
    (function () {
        var header = document.querySelector('[data-header]');
        var toggle = document.querySelector('[data-menu-toggle]');
        var menu = document.getElementById('mobile-menu');

        function onScroll() {
            if (!header) return;
            if (window.scrollY > 40) {
                header.classList.add('bg-white/90', 'shadow-sm', 'backdrop-blur-md');
            } else {
                header.classList.remove('bg-white/90', 'shadow-sm', 'backdrop-blur-md');
            }
        }

        window.addEventListener('scroll', onScroll);
        onScroll();

        toggle?.addEventListener('click', function () {
            menu?.classList.toggle('hidden');
        });

        menu?.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () { menu.classList.add('hidden'); });
        });
    })();
</script>
{% endblock %}
