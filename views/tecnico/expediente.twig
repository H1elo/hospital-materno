{% extends 'layouts/dashboard.twig' %}
{% import 'partials/icon.twig' as ui %}

{% block page_title %}Expediente {{ registro.num_historia }}{% endblock %}
{% block page_subtitle %}{{ registro.nombres }} {{ registro.apellidos }} &middot; {{ registro.nombre_especialidad }}{% endblock %}

{% block page_actions %}
    <a href="{{ url('/tecnico/registros/' ~ registro.id_consulta ~ '/imprimir') }}" class="btn btn-outline btn-sm">
        {{ ui.icon('printer', 'w-4 h-4') }}
        Imprimir
    </a>
    <a href="{{ url('/tecnico/registros') }}" class="btn btn-ghost btn-sm">
        {{ ui.icon('arrow-left', 'w-4 h-4') }}
        Volver
    </a>
{% endblock %}

{% block content %}
<div class="alert alert-info mb-6">
    {{ ui.icon('info', 'w-[17px] h-[17px] shrink-0') }}
    <p class="flex-1">Vista de solo lectura. El tecnico de registro no puede modificar la historia clinica.</p>
</div>

<div class="grid gap-6 xl:grid-cols-[1fr_2fr]">
    {# ------------------------------ Identificacion ------------------------- #}
    <div class="space-y-6">
        <div class="card-soft">
            <div class="flex items-center gap-4">
                <span class="avatar !h-14 !w-14 !text-lg">{{ (registro.nombres ~ ' ' ~ registro.apellidos)|iniciales }}</span>
                <div class="min-w-0">
                    <h2 class="font-serif text-xl leading-tight">{{ registro.nombres }} {{ registro.apellidos }}</h2>
                    <p class="text-sm text-foreground/55">{{ registro.nacionalidad }}-{{ registro.cedula }}</p>
                </div>
            </div>

            <div class="mt-5 grid grid-cols-2 gap-3">
                {% for item in [
                    { label: 'Expediente', value: registro.num_historia },
                    { label: 'Edad', value: registro.edad ~ ' anios' },
                    { label: 'Especialidad', value: registro.nombre_especialidad },
                    { label: 'Medico', value: registro.medico_nombres ~ ' ' ~ registro.medico_apellidos },
                    { label: 'Colegiatura', value: registro.num_colegiatura },
                    { label: 'Fecha', value: registro.fecha_consulta|fecha('d/m/Y H:i') }
                ] %}
                    <div class="rounded-2xl bg-background px-3 py-2">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-foreground/40">{{ item.label }}</p>
                        <p class="truncate text-sm font-semibold">{{ item.value ?: '-' }}</p>
                    </div>
                {% endfor %}
            </div>

            <div class="mt-3 rounded-2xl bg-primary-soft/50 px-4 py-3">
                <p class="text-[10px] font-bold uppercase tracking-wider text-primary-deep">Motivo de consulta</p>
                <p class="text-sm font-semibold">{{ registro.motivo_consulta ?: '-' }}</p>
            </div>
        </div>

        {# ---------------------------- Antecedentes --------------------------- #}
        <div class="card-soft">
            <h2 class="mb-4 font-serif text-lg">Antecedentes</h2>
            <div class="grid grid-cols-2 gap-3">
                {% for item in [
                    { label: 'Gestas', value: registro.gestas },
                    { label: 'Partos', value: registro.partos },
                    { label: 'Abortos', value: registro.abortos },
                    { label: 'Cesareas', value: registro.cesareas },
                    { label: 'FUR', value: registro.fecha_ultima_regla|fecha },
                    { label: 'Citologia', value: registro.fecha_ultima_citologia|fecha },
                    { label: 'Ciclos', value: registro.ciclos_menstruales },
                    { label: 'Anticonceptivo', value: registro.metodo_anticonceptivo }
                ] %}
                    <div class="rounded-2xl bg-background px-3 py-2">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-foreground/40">{{ item.label }}</p>
                        <p class="truncate text-sm font-semibold">{{ item.value is not null and item.value != '' ? item.value : '-' }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ------------------------------- Consulta ------------------------------ #}
    <div class="space-y-6">
        <div class="card-soft">
            <div class="mb-5 flex items-center justify-between">
                <h2 class="font-serif text-xl">Detalle de la consulta</h2>
                <span class="badge {{ registro.tipo_consulta starts with 'Primera' ? 'badge-pink' : 'badge-lavanda' }}">
                    {{ registro.tipo_consulta }}
                </span>
            </div>

            <div class="space-y-4">
                {% for bloque in [
                    { label: 'Enfermedad actual', value: registro.enfermedad_actual, icon: 'file-text' },
                    { label: 'Examen fisico y signos vitales', value: registro.examen_fisico, icon: 'activity' },
                    { label: 'Diagnostico', value: registro.diagnostico, icon: 'stethoscope' },
                    { label: 'Tratamiento y plan', value: registro.tratamiento_plan, icon: 'book-open' },
                    { label: 'Notas de evolucion', value: registro.notas_evolucion, icon: 'clipboard' }
                ] %}
                    <div class="rounded-2xl border border-border-soft/40 bg-background p-4">
                        <div class="mb-1.5 flex items-center gap-2">
                            {{ ui.icon(bloque.icon, 'w-4 h-4 text-primary') }}
                            <p class="text-[11px] font-bold uppercase tracking-wider text-foreground/45">{{ bloque.label }}</p>
                        </div>
                        <p class="text-sm leading-relaxed text-foreground/80">{{ bloque.value ?: 'No registrado' }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# ----------------------------- Adjuntos ------------------------------ #}
        <div class="card-soft">
            <h2 class="mb-4 font-serif text-lg">Adjuntos y resultados</h2>
            <div class="space-y-3">
                {% for adjunto in adjuntos %}
                    <div class="flex items-center gap-3 rounded-2xl border border-border-soft/40 bg-background p-3">
                        <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-secondary-soft">
                            {{ ui.icon('paperclip', 'w-4 h-4 text-secondary-deep') }}
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-semibold">{{ adjunto.nombre_archivo }}</p>
                            <p class="truncate text-xs text-foreground/50">{{ adjunto.descripcion }}</p>
                        </div>
                        <span class="badge badge-neutral">{{ adjunto.subido_en|fecha }}</span>
                    </div>
                {% else %}
                    <p class="text-sm text-foreground/50">Esta consulta no tiene archivos adjuntos.</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
