{% extends 'layouts/public.twig' %}
{% import 'partials/icon.twig' as ui %}

{% block title %}{{ block('page_title') }} - {{ app_name }}{% endblock %}

{% set nav_items = [] %}
{% if can('Paciente') %}
    {% set nav_items = [
        { label: 'Agendar Cita', path: '/paciente', icon: 'calendar', exact: true },
        { label: 'Mis Datos', path: '/paciente/datos', icon: 'user', exact: false },
        { label: 'Mis Citas', path: '/paciente/citas', icon: 'clipboard', exact: false }
    ] %}
{% elseif can('Medico') %}
    {% set nav_items = [
        { label: 'Inicio', path: '/medico', icon: 'activity', exact: true },
        { label: 'Historias', path: '/medico/historias', icon: 'clipboard', exact: false },
        { label: 'Horario', path: '/medico/horario', icon: 'calendar', exact: false }
    ] %}
{% elseif can('Tecnico de Registro') or can('Tecnico') %}
    {% set nav_items = [
        { label: 'Panel de Estadisticas', path: '/tecnico', icon: 'trending-up', exact: true },
        { label: 'Registros Medicos', path: '/tecnico/registros', icon: 'clipboard', exact: false }
    ] %}
{% elseif can('Administrador') %}
    {% set nav_items = [
        { label: 'Gestion de Personal', path: '/admin', icon: 'users', exact: true },
        { label: 'Horarios y Cupos', path: '/admin/horarios', icon: 'calendar', exact: false }
    ] %}
{% endif %}

{% macro navlink(item, compact) %}
    {% import 'partials/icon.twig' as ui %}
    {% set is_current = item.exact ? exact(item.path) : active(item.path) %}
    <a href="{{ url(item.path) }}"
       class="nav-link {{ is_current ? 'nav-link-active' : '' }} {{ compact ? 'flex-col gap-1 px-2 py-2 text-[10px]' : '' }}">
        {{ ui.icon(item.icon, compact ? 'w-5 h-5' : 'w-[18px] h-[18px]') }}
        <span>{{ item.label }}</span>
    </a>
{% endmacro %}

{% block body %}
<div class="min-h-screen bg-background">
    {# ------------------------------ Sidebar escritorio ------------------------------ #}
    <aside class="fixed inset-y-0 left-0 z-40 hidden w-72 flex-col border-r border-border-soft/40 bg-white px-6 py-8 lg:flex no-print">
        <a href="{{ url('/') }}" class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary-soft shadow-sm">
                {{ ui.icon('heart', 'w-[18px] h-[18px] text-primary fill-primary') }}
            </span>
            <span class="font-serif text-lg font-bold tracking-tight text-foreground">
                Hospital Materno <span class="text-primary">Rosa</span>
            </span>
        </a>

        <nav class="mt-10 flex flex-1 flex-col gap-1.5">
            {% for item in nav_items %}
                {{ _self.navlink(item, false) }}
            {% endfor %}
        </nav>

        <div class="mt-6 rounded-3xl bg-background p-4">
            <div class="flex items-center gap-3">
                <span class="avatar">{{ auth_name()|iniciales }}</span>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-bold text-foreground">{{ auth_name() }}</p>
                    <p class="truncate text-xs text-foreground/50">{{ auth_role() }}</p>
                </div>
            </div>
            <form action="{{ url('/logout') }}" method="post" class="mt-3">
                {{ csrf_field()|raw }}
                <button type="submit" class="btn btn-ghost btn-sm w-full">
                    {{ ui.icon('log-out', 'w-4 h-4') }}
                    Cerrar sesion
                </button>
            </form>
        </div>
    </aside>

    {# --------------------------- Sidebar movil (overlay) --------------------------- #}
    <div id="mobile-sidebar" class="fixed inset-0 z-50 hidden lg:hidden no-print" data-sidebar>
        <div class="absolute inset-0 bg-foreground/40 backdrop-blur-sm" data-sidebar-close></div>
        <aside class="relative flex h-full w-72 max-w-[80%] flex-col bg-white px-6 py-7 shadow-2xl">
            <div class="flex items-center justify-between">
                <span class="font-serif text-lg font-bold text-foreground">
                    Materno <span class="text-primary">Rosa</span>
                </span>
                <button type="button" class="rounded-full p-2 text-foreground/50 hover:bg-muted" data-sidebar-close>
                    {{ ui.icon('x', 'w-5 h-5') }}
                </button>
            </div>

            <div class="mt-6 flex items-center gap-3 rounded-2xl bg-background p-3">
                <span class="avatar">{{ auth_name()|iniciales }}</span>
                <div class="min-w-0">
                    <p class="truncate text-sm font-bold">{{ auth_name() }}</p>
                    <p class="truncate text-xs text-foreground/50">{{ auth_role() }}</p>
                </div>
            </div>

            <nav class="mt-6 flex flex-1 flex-col gap-1.5">
                {% for item in nav_items %}
                    {% set is_current = item.exact ? exact(item.path) : active(item.path) %}
                    <a href="{{ url(item.path) }}" class="nav-link {{ is_current ? 'nav-link-active' : '' }}">
                        {{ ui.icon(item.icon, 'w-[18px] h-[18px]') }}
                        <span>{{ item.label }}</span>
                    </a>
                {% endfor %}
            </nav>

            <form action="{{ url('/logout') }}" method="post">
                {{ csrf_field()|raw }}
                <button type="submit" class="btn btn-outline btn-block">
                    {{ ui.icon('log-out', 'w-4 h-4') }}
                    Cerrar sesion
                </button>
            </form>
        </aside>
    </div>

    {# ---------------------------------- Contenido ---------------------------------- #}
    <div class="lg:pl-72">
        <header class="sticky top-0 z-30 flex items-center gap-4 border-b border-border-soft/40 bg-white/90 px-5 py-4 backdrop-blur-md lg:px-10 no-print">
            <button type="button" class="rounded-full p-2 text-foreground/60 hover:bg-muted lg:hidden" data-sidebar-toggle>
                {{ ui.icon('menu', 'w-5 h-5') }}
            </button>

            <div class="min-w-0 flex-1">
                <h1 class="truncate font-serif text-xl text-foreground lg:text-2xl">{% block page_title %}Panel{% endblock %}</h1>
                <p class="truncate text-xs font-semibold text-foreground/45">{% block page_subtitle %}{% endblock %}</p>
            </div>

            <div class="hidden items-center gap-3 sm:flex">
                {% block page_actions %}{% endblock %}
            </div>

            <span class="hidden h-9 w-9 items-center justify-center rounded-full bg-primary-soft text-xs font-bold text-primary sm:flex lg:hidden">
                {{ auth_name()|iniciales }}
            </span>
        </header>

        <main class="px-5 pb-28 pt-6 lg:px-10 lg:pb-12">
            <div class="mb-5 flex flex-wrap items-center gap-3 sm:hidden">
                {% block page_actions_mobile %}{% endblock %}
            </div>

            {% block content %}{% endblock %}
        </main>
    </div>

    {# ------------------------------- Nav inferior movil ---------------------------- #}
    <nav class="fixed inset-x-0 bottom-0 z-40 flex border-t border-border-soft/40 bg-white/95 backdrop-blur-md lg:hidden no-print">
        {% for item in nav_items %}
            {% set is_current = item.exact ? exact(item.path) : active(item.path) %}
            <a href="{{ url(item.path) }}"
               class="flex flex-1 flex-col items-center gap-1 py-3 text-[10px] font-bold transition-colors {{ is_current ? 'text-primary' : 'text-foreground/40' }}">
                {{ ui.icon(item.icon, 'w-5 h-5') }}
                <span>{{ item.label|split(' ')|first }}</span>
            </a>
        {% endfor %}
    </nav>
</div>
{% endblock %}
