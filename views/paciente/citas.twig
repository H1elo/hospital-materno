{% extends 'layouts/dashboard.twig' %}
{% import 'partials/icon.twig' as ui %}

{% block page_title %}Mis Citas{% endblock %}
{% block page_subtitle %}Historial de citas y resultados de consulta{% endblock %}

{% block page_actions %}
    <a href="{{ url('/paciente') }}" class="btn btn-primary btn-sm">
        {{ ui.icon('plus', 'w-4 h-4') }}
        Agendar cita
    </a>
{% endblock %}

{% block content %}
{% set estados = {
    'Pendiente': 'badge-lavanda',
    'Atendida':  'badge-mint',
    'Cancelada': 'badge-danger'
} %}

<div class="space-y-4">
    {% for cita in citas %}
        <article class="card-soft">
            <div class="flex flex-wrap items-start gap-4">
                <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-2xl bg-primary-soft text-primary">
                    <span class="font-serif text-2xl leading-none">{{ cita.fecha_cita|date('d') }}</span>
                    <span class="text-[10px] font-bold uppercase">{{ cita.fecha_cita|date('M') }}</span>
                </div>

                <div class="min-w-[200px] flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 class="font-bold text-foreground">{{ cita.nombre_especialidad }}</h3>
                        <span class="badge {{ estados[cita.estado] ?? 'badge-neutral' }}">{{ cita.estado }}</span>
                    </div>
                    <p class="mt-1 text-sm text-foreground/60">
                        {{ cita.medico_nombres }} {{ cita.medico_apellidos }}
                    </p>
                    <p class="mt-1 text-xs text-foreground/50">
                        {{ cita.fecha_cita|fecha }} &middot; {{ cita.hora_cita|slice(0, 5) }}
                    </p>
                    {% if cita.motivo_consulta %}
                        <p class="mt-2 text-sm text-foreground/70">{{ cita.motivo_consulta }}</p>
                    {% endif %}
                </div>

                <div class="flex flex-col items-stretch gap-2">
                    <a href="{{ url('/paciente/citas/' ~ cita.id_cita ~ '/comprobante') }}" class="btn btn-ghost btn-sm">
                        {{ ui.icon('printer', 'w-4 h-4') }}
                        Comprobante
                    </a>

                    {% if cita.estado == 'Pendiente' %}
                        <form method="post" action="{{ url('/paciente/citas/' ~ cita.id_cita ~ '/cancelar') }}"
                              data-confirm="Seguro que deseas cancelar esta cita?">
                            {{ csrf_field()|raw }}
                            <button type="submit" class="btn btn-ghost btn-sm w-full !text-danger">
                                {{ ui.icon('x', 'w-4 h-4') }}
                                Cancelar
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>

            {% if cita.id_consulta %}
                <details class="mt-4 rounded-2xl border border-accent-soft bg-accent-soft/30 p-4">
                    <summary class="cursor-pointer text-sm font-bold text-accent-deep">
                        Ver receta y diagnostico ({{ cita.tipo_consulta }})
                    </summary>
                    <div class="mt-4 grid gap-3 sm:grid-cols-2">
                        <div class="rounded-2xl bg-white p-4">
                            <p class="text-[11px] font-bold uppercase tracking-wider text-foreground/40">Diagnostico</p>
                            <p class="mt-1 text-sm">{{ cita.diagnostico }}</p>
                        </div>
                        <div class="rounded-2xl bg-white p-4">
                            <p class="text-[11px] font-bold uppercase tracking-wider text-foreground/40">Tratamiento / plan</p>
                            <p class="mt-1 text-sm">{{ cita.tratamiento_plan ?: 'No indicado' }}</p>
                        </div>
                        {% if cita.notas_evolucion %}
                            <div class="rounded-2xl bg-white p-4 sm:col-span-2">
                                <p class="text-[11px] font-bold uppercase tracking-wider text-foreground/40">Notas de evolucion</p>
                                <p class="mt-1 text-sm">{{ cita.notas_evolucion }}</p>
                            </div>
                        {% endif %}
                    </div>
                    <p class="mt-3 text-xs text-foreground/50">
                        Atendida el {{ cita.fecha_consulta|fecha('d/m/Y H:i') }}
                    </p>
                </details>
            {% endif %}
        </article>
    {% else %}
        <div class="card-soft text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-soft">
                {{ ui.icon('calendar', 'w-6 h-6 text-primary') }}
            </div>
            <h3 class="font-serif text-xl">No tienes citas registradas</h3>
            <p class="mt-1 text-sm text-foreground/55">Agenda tu primera consulta con nuestros especialistas.</p>
            <a href="{{ url('/paciente') }}" class="btn btn-primary mt-5">Agendar cita</a>
        </div>
    {% endfor %}
</div>
{% endblock %}
