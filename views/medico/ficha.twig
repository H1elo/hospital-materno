{% extends 'layouts/dashboard.twig' %}
{% import 'partials/icon.twig' as ui %}

{% block page_title %}Ficha Clinica{% endblock %}
{% block page_subtitle %}{{ cita.nombres }} {{ cita.apellidos }} &middot; {{ cita.num_historia }}{% endblock %}

{% block page_actions %}
    <a href="{{ url('/medico/historias') }}" class="btn btn-ghost btn-sm">
        {{ ui.icon('arrow-left', 'w-4 h-4') }}
        Volver
    </a>
{% endblock %}

{% block content %}
<div class="grid gap-6 xl:grid-cols-[1fr_2fr]">
    {# -------------------------- Identificacion ---------------------------- #}
    <div class="space-y-6">
        <div class="card-soft">
            <div class="flex items-center gap-4">
                <span class="avatar !h-14 !w-14 !text-lg">{{ (cita.nombres ~ ' ' ~ cita.apellidos)|iniciales }}</span>
                <div class="min-w-0">
                    <h2 class="font-serif text-xl leading-tight">{{ cita.nombres }} {{ cita.apellidos }}</h2>
                    <p class="text-sm text-foreground/55">{{ cita.num_historia }}</p>
                </div>
            </div>

            <div class="mt-5 grid grid-cols-2 gap-3">
                {% for item in [
                    { label: 'Cedula', value: '-' },
                    { label: 'Edad', value: cita.edad ~ ' anios' },
                    { label: 'Fecha nac.', value: cita.fecha_nacimiento|fecha },
                    { label: 'Telefono', value: cita.telefono },
                    { label: 'Estado civil', value: cita.estado_civil },
                    { label: 'Ocupacion', value: cita.ocupacion }
                ] %}
                    <div class="rounded-2xl bg-background px-3 py-2">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-foreground/40">{{ item.label }}</p>
                        <p class="truncate text-sm font-semibold">{{ item.value ?: '-' }}</p>
                    </div>
                {% endfor %}
            </div>

            <div class="mt-3 rounded-2xl bg-primary-soft/50 px-4 py-3">
                <p class="text-[10px] font-bold uppercase tracking-wider text-primary-deep">Motivo de la cita</p>
                <p class="text-sm font-semibold">{{ cita.motivo_consulta ?: '-' }}</p>
            </div>
        </div>

        {# ------------------------- Antecedentes -------------------------- #}
        <div class="card-soft">
            <h2 class="mb-4 font-serif text-lg">Antecedentes</h2>
            {% if antecedentes %}
                <div class="grid grid-cols-2 gap-3">
                    {% for item in [
                        { label: 'Menarquia', value: antecedentes.menarquia },
                        { label: 'Sexarquia', value: antecedentes.sexarquia },
                        { label: 'Gestas', value: antecedentes.gestas },
                        { label: 'Partos', value: antecedentes.partos },
                        { label: 'Abortos', value: antecedentes.abortos },
                        { label: 'Cesareas', value: antecedentes.cesareas },
                        { label: 'FUR', value: antecedentes.fecha_ultima_regla|fecha },
                        { label: 'Citologia', value: antecedentes.fecha_ultima_citologia|fecha },
                        { label: 'Ciclos', value: antecedentes.ciclos_menstruales },
                        { label: 'Anticonceptivo', value: antecedentes.metodo_anticonceptivo }
                    ] %}
                        <div class="rounded-2xl bg-background px-3 py-2">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-foreground/40">{{ item.label }}</p>
                            <p class="truncate text-sm font-semibold">{{ item.value is not null and item.value != '' ? item.value : '-' }}</p>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-sm text-foreground/50">Sin antecedentes registrados.</p>
            {% endif %}
        </div>

        {# ------------------------ Historial previo ----------------------- #}
        <div class="card-soft">
            <h2 class="mb-4 font-serif text-lg">Historial previo</h2>
            <div class="space-y-3 max-h-[420px] overflow-y-auto pr-1">
                {% for previa in previas %}
                    <div class="rounded-2xl border border-border-soft/40 bg-background p-3">
                        <div class="flex items-center justify-between gap-2">
                            <span class="badge {{ previa.tipo_consulta starts with 'Primera' ? 'badge-pink' : 'badge-lavanda' }}">
                                {{ previa.tipo_consulta starts with 'Primera' ? 'Primera vez' : 'Control' }}
                            </span>
                            <span class="text-xs text-foreground/45">{{ previa.fecha_consulta|fecha }}</span>
                        </div>
                        <p class="mt-2 text-xs font-bold uppercase tracking-wider text-foreground/40">Diagnostico</p>
                        <p class="text-sm">{{ previa.diagnostico }}</p>
                        {% if previa.tratamiento_plan %}
                            <p class="mt-2 text-xs font-bold uppercase tracking-wider text-foreground/40">Tratamiento</p>
                            <p class="text-sm text-foreground/70">{{ previa.tratamiento_plan }}</p>
                        {% endif %}
                    </div>
                {% else %}
                    <p class="text-sm text-foreground/50">Paciente sin consultas previas. Corresponde apertura de historia.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ------------------------------- Formulario --------------------------- #}
    <form method="post" action="{{ url('/medico/historias/' ~ cita.id_cita) }}" class="space-y-6">
        {{ csrf_field()|raw }}

        <div class="card-soft">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <h2 class="font-serif text-xl">Registro de consulta</h2>
                {% if consulta %}
                    <span class="badge badge-mint">{{ ui.icon('check', 'w-3.5 h-3.5') }} Historia guardada</span>
                {% else %}
                    <span class="badge badge-lavanda">Sin registrar</span>
                {% endif %}
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="sm:col-span-2">
                    <label for="tipo_consulta" class="label">Tipo de consulta</label>
                    {% set tipoActual = consulta.tipo_consulta ?? (previas|length > 0 ? 'Control / Evolucion' : 'Primera Vez / Apertura') %}
                    <select id="tipo_consulta" name="tipo_consulta" class="select" required>
                        <option value="Primera Vez / Apertura" {{ tipoActual == 'Primera Vez / Apertura' ? 'selected' : '' }}>Primera Vez / Apertura</option>
                        <option value="Control / Evolucion" {{ tipoActual == 'Control / Evolucion' ? 'selected' : '' }}>Control / Evolucion</option>
                    </select>
                    {% if error('tipo_consulta') %}<p class="field-error">{{ error('tipo_consulta') }}</p>{% endif %}
                </div>

                <div class="sm:col-span-2">
                    <label for="enfermedad_actual" class="label">Enfermedad actual</label>
                    <textarea id="enfermedad_actual" name="enfermedad_actual" rows="3" class="textarea"
                              placeholder="Relato del padecimiento, inicio, evolucion y sintomas">{{ consulta.enfermedad_actual ?? '' }}</textarea>
                </div>

                <div class="sm:col-span-2">
                    <label for="examen_fisico" class="label">Examen fisico y signos vitales</label>
                    <textarea id="examen_fisico" name="examen_fisico" rows="3" class="textarea"
                              placeholder="TA 120/80, FC 78 lpm, Temp 36.5 C, Peso, Talla... y hallazgos al examen">{{ consulta.examen_fisico ?? '' }}</textarea>
                </div>

                <div class="sm:col-span-2">
                    <label for="diagnostico" class="label">Diagnostico <span class="text-danger">*</span></label>
                    <textarea id="diagnostico" name="diagnostico" rows="3" class="textarea" required
                              placeholder="Diagnostico principal y secundarios">{{ consulta.diagnostico ?? '' }}</textarea>
                    {% if error('diagnostico') %}<p class="field-error">{{ error('diagnostico') }}</p>{% endif %}
                </div>

                <div class="sm:col-span-2">
                    <label for="tratamiento_plan" class="label">Tratamiento y plan</label>
                    <textarea id="tratamiento_plan" name="tratamiento_plan" rows="3" class="textarea"
                              placeholder="Medicamentos, dosis, indicaciones y proximo control">{{ consulta.tratamiento_plan ?? '' }}</textarea>
                </div>

                <div class="sm:col-span-2">
                    <label for="notas_evolucion" class="label">Notas de evolucion (hoja de control)</label>
                    <textarea id="notas_evolucion" name="notas_evolucion" rows="3" class="textarea"
                              placeholder="Evolucion, seguimiento y observaciones">{{ consulta.notas_evolucion ?? '' }}</textarea>
                </div>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
                <button type="submit" class="btn btn-primary">
                    {{ ui.icon('check', 'w-4 h-4') }}
                    {{ consulta ? 'Actualizar historia' : 'Guardar y marcar atendida' }}
                </button>
                <a href="{{ url('/medico/historias') }}" class="btn btn-ghost">Cancelar</a>
            </div>
        </div>
    </form>
</div>
{% endblock %}
